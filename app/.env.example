# Copy to app/.env before deploying. Configure your proxy/deployment service to route
# the web domain to ui:3000 and the SDK/API domain to api:8080 (no host ports are published).
POSTGRES_PASSWORD=replace-with-a-long-random-password
# The web build and API must use the same dashboard origin. Rebuild when it changes.
FLOCK_WEB_URL=https://flock.example.com
# Must be reachable from training machines; used by both the API and web server.
FLOCK_API_PUBLIC_URL=https://api.flock.example.com
# The web server uses a Flock-specific alias to avoid shared-network DNS collisions.
# FLOCK_API_URL=http://flock-api:8080
# FLOCK_VERSION=latest
# Optional API settings use their defaults when unset or empty.
# FLOCK_GOOGLE_CLIENT_ID=
# FLOCK_GOOGLE_CLIENT_SECRET=
